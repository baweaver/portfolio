<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="base-path" content="<%= site.base_path %>" />
<title><%= resource.data.title ? "#{resource.data.title} | baweaver" : "baweaver" %></title>
<link rel="canonical" href="<%= "#{site.config.url}#{resource.relative_url}" %>" />
<% description = resource.data.description || "Engineering systems that endure." %>
<meta name="description" content="<%= description %>" />
<meta property="og:title" content="<%= resource.data.title || "baweaver" %>" />
<meta property="og:description" content="<%= description %>" />
<meta property="og:url" content="<%= "#{site.config.url}#{resource.relative_url}" %>" />
<meta property="og:site_name" content="baweaver" />
<meta property="og:type" content="<%= resource.collection&.label == "posts" ? "article" : "website" %>" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content="<%= resource.data.title || "baweaver" %>" />
<meta name="twitter:description" content="<%= description %>" />
<link rel="alternate" type="application/atom+xml" title="baweaver" href="/feed.xml" />
<% if resource.collection&.label == "posts" %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "<%= resource.data.title %>",
  "description": "<%= description %>",
  "datePublished": "<%= resource.data.date.strftime("%Y-%m-%d") %>",
  "author": { "@type": "Person", "name": "Brandon Weaver", "url": "https://baweaver.com/about/" },
  "publisher": { "@type": "Person", "name": "Brandon Weaver" },
  "url": "<%= "#{site.config.url}#{resource.relative_url}" %>"
}
</script>
<% end %>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700;800&family=Caveat:wght@400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Kalam:wght@300;400;700&display=swap" />
<% if Bridgetown.env.development? %>
<script>
// Monkey-patch EventSource to track and close on navigation
(function() {
  const OrigES = EventSource;
  window.EventSource = function(url) {
    const es = new OrigES(url);
    window._liveReloadES = es;
    return es;
  };
  window.addEventListener("pagehide", () => {
    if (window._liveReloadES) window._liveReloadES.close();
  });
})();
</script>
<%= live_reload_dev_js %>
<% end %>
<link rel="stylesheet" href="<%= asset_path "styles/index.css" %>" />
<!-- Privacy-friendly analytics by Plausible -->
<script async src="https://plausible.io/js/pa-tKrSzqnRFi9GRgnxD2L03.js"></script>
<script>
  window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
  plausible.init()
</script>
<script src="<%= asset_path "javascript/index.js" %>" defer></script>
