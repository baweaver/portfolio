---
layout: default
title: Home
---
<div>
  <section class="hero-grid">
    <div class="hero-text">
      <h1 class="hero-headline">
        Engineering<br>Systems<br><em>That Endure.</em>
      </h1>
      <p class="prose">
        Software engineering for complex systems.<br>Built with clarity. Designed to last.
      </p>
      <div class="hero-ctas">
        <a href="<%= relative_url "/about" %>" class="btn-primary">About Me →</a>
        <a href="<%= relative_url "/philosophy" %>" class="btn-secondary">About My Approach</a>
      </div>
    </div>
    <div class="hero-image">
      <div class="hero-fade"></div>
      <%== img "/images/hero_handdrawn.png", alt: "Architectural sketch", class: "hero-img" %>
    </div>
  </section>

  <section class="banner">
    <div class="banner-icons">
      <div class="text-center">
        <%== img "/images/tree-accent.png", alt: "Cross-section of tree rings", class: "accent-icon" %>
        <h3 class="banner-label">Clean Code</h3>
        <p class="banner-desc">Readable, maintainable code that stands the test of time.</p>
      </div>
      <div class="text-center">
        <%== img "/images/leaf-accent.png", alt: "A delicate leaf", class: "accent-icon" %>
        <h3 class="banner-label">Thoughtful Design</h3>
        <p class="banner-desc">Intentional architecture shaped by the people who have to live with it.</p>
      </div>
      <div class="text-center">
        <%== img "/images/box-accent.png", alt: "Interlocking boxes", class: "accent-icon" %>
        <h3 class="banner-label">System Thinking</h3>
        <p class="banner-desc">Designing systems that stay simple as the problems around them grow.</p>
      </div>
      <div class="text-center">
        <%== img "/images/mountain-accent.png", alt: "A mountain peak", class: "accent-icon" %>
        <h3 class="banner-label">Continuous Improvement</h3>
        <p class="banner-desc">Small, steady changes that compound over time.</p>
      </div>
    </div>
    <div class="banner-text-area">
      <p>
        I bring clarity to complex systems and help the people in them do work they're proud of.
      </p>
      <a href="<%= relative_url "/contact" %>" class="banner-cta">Let's Get to Work →</a>
    </div>
  </section>

  <section class="section-padded">
    <div class="latest-header">
      <h2 class="latest-title">Latest Posts</h2>
      <span class="latest-line"></span>
      <a href="<%= relative_url "/writing" %>" class="latest-link">View All →</a>
    </div>
    <div class="latest-grid">
      <% collections.posts.resources.select { |p| p.data.date }.sort_by { |p| p.data.date }.reverse.first(3).each do |post| %>
        <a href="<%= post.relative_url %>" class="latest-card">
          <span class="latest-card-date"><%= post.data.date.strftime("%b %d, %Y") %></span>
          <h3><%= post.data.title %></h3>
          <p><%= post.data.description&.slice(0, 100) %></p>
        </a>
      <% end %>
    </div>
  </section>
</div>
