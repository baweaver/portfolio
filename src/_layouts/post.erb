---
layout: default
---
<div class="post-layout">
  <article class="blog-post">
    <nav class="breadcrumb">
      <a href="/">Home</a> / <a href="/writing">Writing</a> / Post
    </nav>
    <div class="post-meta">
      <% if resource.data.tags&.any? %>
        <span class="post-category"><%= resource.data.tags.first %></span>
      <% end %>
      <span class="post-date"><%= resource.data.date.strftime("%B %d, %Y") %></span>
    </div>
    <h1 class="post-title"><%= resource.data.title %></h1>
    <hr class="title-rule" />
    <div class="post-body">
      <%= yield %>
    </div>
  </article>
  <aside class="post-sidebar">
    <div class="author-card">
      <h3 class="sidebar-heading">About the Author</h3>
      <%== img "/images/profile.jpeg", alt: "Brandon Weaver", class: "author-photo" %>
      <strong class="author-name">Brandon Weaver</strong>
      <p class="author-bio">I help organizations turn complex problems into robust, elegant software. From backend systems to developer experience, I build solutions that are reliable, scalable, and a joy to work with.</p>
      <a href="/about" class="author-link">More About Me →</a>
    </div>
    <% series = post_series(resource) %>
    <% if resource.data.tags&.any? %>
      <div class="tag-section">
        <h3 class="sidebar-heading">Tags</h3>
        <div class="tag-list">
          <% resource.data.tags.each do |tag| %>
            <a href="<%= relative_url "/tags/#{tag.downcase.gsub(/[^a-z0-9]+/, "-").gsub(/-+$/, "")}/" %>" class="tag"><%= tag %></a>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if series %>
      <div class="series-nav">
        <h3 class="sidebar-heading">In This Series</h3>
        <strong class="series-title"><%= series["title"] %></strong>
        <span class="series-meta"><%= series["current_index"] + 1 %> of <%= series["posts"].length %></span>
        <div class="series-arrows">
          <% if series["prev"] %>
            <a href="<%= series["prev"].relative_url %>" class="series-arrow">← Previous</a>
          <% else %>
            <span class="series-arrow disabled">← Previous</span>
          <% end %>
          <% if series["next"] %>
            <a href="<%= series["next"].relative_url %>" class="series-arrow">Next →</a>
          <% else %>
            <span class="series-arrow disabled">Next →</span>
          <% end %>
        </div>
        <details class="series-all">
          <summary>All posts in series</summary>
          <ol class="series-posts">
            <% series["posts"].each do |p| %>
              <li class="<%= 'current' if p.relative_url == resource.relative_url %>">
                <a href="<%= p.relative_url %>"><%= short_title(p, series["title"]) %></a>
              </li>
            <% end %>
          </ol>
        </details>
      </div>
    <% end %>
    <%= render Shared::PathNav.new(resource: resource, site: site) %>
    <%= render Shared::RelatedPosts.new(resource: resource, site: site) %>
  </aside>
</div>
<div class="post-comments">
  <script src="https://giscus.app/client.js"
          data-repo="baweaver/portfolio"
          data-repo-id="R_kgDOSo4uDw"
          data-category="Announcements"
          data-category-id="DIC_kwDOSo4uD84C9_zC"
          data-mapping="pathname"
          data-strict="1"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="catppuccin_mocha"
          data-lang="en"
          data-loading="lazy"
          crossorigin="anonymous"
          async>
  </script>
</div>
<% if series %>
<div class="series-sticky">
  <% if series["prev"] %>
    <a href="<%= series["prev"].relative_url %>">← Prev</a>
  <% else %>
    <span class="disabled">← Prev</span>
  <% end %>
  <span class="series-pos"><%= series["current_index"] + 1 %> of <%= series["posts"].length %></span>
  <% if series["next"] %>
    <a href="<%= series["next"].relative_url %>">Next →</a>
  <% else %>
    <span class="disabled">Next →</span>
  <% end %>
</div>
<% end %>
<button class="back-to-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="Back to top">↑</button>
<script>
window.addEventListener("scroll", () => {
  const btn = document.querySelector(".back-to-top");
  if (btn) btn.classList.toggle("visible", window.scrollY > 600);
});
</script>
